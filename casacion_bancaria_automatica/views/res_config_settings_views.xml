<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.casacion.bancaria</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='account']" position="inside">
                <h2>Casación bancaria automática (ChatGPT)</h2>
                <div class="row mt16 o_settings_container" name="casacion_bancaria_automatica">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="casacion_openai_api_key" string="Clave API de OpenAI"/>
                            <div class="text-muted">
                                Vacía: se usa la clave del módulo de facturas con IA o la variable OPENAI_API_KEY.
                            </div>
                            <field name="casacion_openai_api_key" password="True" placeholder="sk-proj-..."/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="casacion_openai_model" string="Modelo"/>
                            <div class="text-muted">Modelo de OpenAI, por ejemplo gpt-4o-mini o gpt-4o.</div>
                            <field name="casacion_openai_model" placeholder="gpt-4o-mini"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="casacion_openai_base" string="URL base"/>
                            <div class="text-muted">Opcional, para endpoints compatibles con OpenAI.</div>
                            <field name="casacion_openai_base" placeholder="https://api.openai.com/v1"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Prompts</span>
                            <div class="text-muted">Versiones del prompt que se envía a ChatGPT.</div>
                            <button name="%(action_casacion_bancaria_prompt)d" type="action"
                                    string="Prompts IA de casación" icon="fa-arrow-right" class="btn-link"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
